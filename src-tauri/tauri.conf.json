{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluent Coder",
  "version": "0.1.0",
  "identifier": "com.fluentcoder.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Fluent Coder",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../tools/razor-sidecar/RazorSidecar.csproj": "tools/razor-sidecar/RazorSidecar.csproj",
      "../tools/razor-sidecar/Program.cs": "tools/razor-sidecar/Program.cs",
      "../tools/ext-host/main.js": "tools/ext-host/main.js",
      "../tools/ext-host/package.json": "tools/ext-host/package.json",
      "../tools/ext-host/src/*.js": "tools/ext-host/src/",
      "../tools/ext-host/src/shim/*.js": "tools/ext-host/src/shim/"
    },
    "fileAssociations": [
      {
        "ext": ["fluent-workspace"],
        "name": "Fluent Workspace",
        "description": "Fluent Code workspace",
        "mimeType": "application/vnd.fluentcoder.workspace+json",
        "exportedType": {
          "identifier": "com.fluentcoder.workspace",
          "conformsTo": ["public.json"]
        }
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "fluent-coder"
        ]
      }
    }
  }
}
