  "comments": {
    "overrides": "Patch legacy transitives from material-icon-theme -> biome@0.3.3. These dependencies are not part of the product's runtime path, but installation/build tooling still requires security review. The deprecated request package is aliased to @cypress/request. Keep compatible fixes locked and validate the affected consumers after updates.",
    "overrides-dompurify": "@codingame/monaco-vscode-api@25.1.2 pins dompurify@3.3.1. Require at least 3.4.17 to address the currently reported advisories while preserving the coordinated Monaco 25 stack. DOMPurify executes in the editor at runtime; browser validation of the actual sanitizer remains required."
  },
  "overrides": {
    "lodash": "^4.18.1",
    "form-data": "^4.0.6",
    "tough-cookie": "^4.1.4",
    "qs": "^6.17.0",
    "uuid": "^11.1.1",
    "request": "npm:@cypress/request@^4.0.1",
    "dompurify": "^3.4.17"
  }
