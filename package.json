{
  "name": "fluent-coder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:unit": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"tools/ext-host/test/*.test.js\"",
    "test:ext-host": "node --test \"tools/ext-host/test/*.test.js\"",
    "ext-host:check": "node tools/ext-host/scripts/headless-check.js",
    "ext-host:flows": "node tools/ext-host/scripts/flows-check.js",
    "ext-host:orphan-check": "node tools/ext-host/scripts/orphan-check.js",
    "ext-host:capabilities": "node tools/ext-host/discovery/capabilities.js",
    "ext-host:catalog-check": "node --experimental-strip-types tools/ext-host/scripts/catalog-check.mts",
    "pr:check": "node scripts/pr-check.mjs",
    "test:pr-check": "node --test scripts/pr-check.test.mjs"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "^25.1.2",
